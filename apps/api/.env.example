DATABASE_URL=postgresql://localhost:5432/internship
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-random-local-secret
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Set true for HTTPS deployment
COOKIE_SECURE=false

# AI chat module: choose ollama / deepseek / qwen / gpt / kimi
AI_MODEL_PROVIDER=ollama
AI_MODEL_TIMEOUT_MS=120000
# For remote providers all three fields (BASE_URL, MODEL, API_KEY) are required.
# OPENAI_* above configures GPT; model is explicit, never sent to the browser with a key.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
# Copy the workspace/region-specific compatible-mode/v1 URL from your Qwen console.
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_KEY=
# Region-specific Kimi example; use the endpoint shown by your account.
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
KIMI_API_KEY=

# AI isolation: server-owned map of user UUID -> tenant UUID and audit administrator flag.
# Unlisted users get a personal tenant (tenantId=userId), never administrator privileges.
AI_TENANT_MEMBERSHIPS={}
# The legacy companies dataset may be read by AI tools only for this ONE tenant.
# Empty denies all AI business-tool access. It does not alter legacy business API permissions.
AI_BUSINESS_TENANT_ID=
# Domain cache policy: enabled + TTL seconds. Missing domains default to 600 seconds.
AI_CHAT_CACHE_POLICIES={"users":{"enabled":true,"ttl":600},"companies":{"enabled":true,"ttl":600},"conversation":{"enabled":true,"ttl":600}}

# Explicit AI tool grants: own-user reads are default; tenant-user/config permissions and
# write-tool previews require grants (users:write / companies:write).
# Job-title role and auditAdmin do NOT grant tool configuration rights.
AI_TOOL_PERMISSIONS={}
# Higher-priority server-side kill switch; comma-separated registered tool names.
AI_DISABLED_TOOLS=
